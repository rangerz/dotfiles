Host *
    # Load keys into ssh-agent on first use; UseKeychain is macOS-only,
    # so IgnoreUnknown must come first to keep Linux OpenSSH from erroring.
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes

    ControlMaster auto
    ControlPath ~/.ssh/mux/%r@%h:%p
    ControlPersist 30m
