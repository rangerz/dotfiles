{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "language": "traditional chinese",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "next-steps@claude-community": {
      "options": {
        "suggestSkills": true
      }
    }
  },
  "tui": "fullscreen",
  "switchModelsOnFlag": true,
  "skipAutoPermissionPrompt": true
}
