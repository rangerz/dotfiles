{
  "agentMode": "accept-edits",
  "toolPermission": "proceed-in-sandbox",
  "verbosity": "low",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.dotfiles/agents/agy/statusline.sh",
    "enabled": true
  },
  "permissions": {
    "deny": [
      "command(rm -rf)",
      "command(sudo)",
      "write_file(.git/)",
      "write_file(.env*)"
    ]
  },
  "altScreenMode": "always",
  "showFeedbackSurvey": false,
  "enableTerminalSandbox": true,
  "showTips": false,
  "artifactReviewPolicy": "agent-decides",
  "notifications": true
}
