"Vim Options: http://vimdoc.sourceforge.net/htmldoc/options.html

"Encoding
set encoding=utf-8                    "(enc)
set fileencodings=ucs-bom,utf-8,cp950 "(fencs)
"set termencoding=utf-8              "(tenc)

"Basics
syntax on
syntax enable
set nocompatible    "(nocp) not vi-compatible
set showmode        "(smd)
set showcmd         "(sc)
set fileformat=unix "(ff)
colo torte
filetype plugin indent on

"Mouse
set mouse=a
set selection=exclusive  "(sel)
set selectmode=mouse,key "(slm)

"Indent
set autoindent      "(ai) keep the previous line's indent
set smartindent     "(si) indent after braces {}
set cindent         "(cin) C-style indenting
set expandtab       "(et) insert spaces for Tab
set tabstop=8       "(ts) show a Tab as 8 spaces
set shiftwidth=4    "(sw) indent width
set softtabstop=0 smarttab     "(sts) Backspace width
set backspace=eol,start,indent "(bs)

"Appearance
set ruler           "(ru) show the ruler
set number          "(nu) show line numbers
"set relativenumber "(rnu) show relative line numbers
set cursorline      "(cul) highlight the cursor line
"set cursorcolumn   "(cuc) highlight the cursor column
"set textwidth=80   "(tw)
set wrap            "wrap long lines
set linebreak       "(lbr) do not break words when wrapping
set wrapmargin=2    "(wm)
set laststatus=3    "(ls) status line: 0=never 1=only with split windows 2=always 3=one global line
set scrolloff=3     "(so) keep 3 lines above and below the cursor

"Highlight the cursor line only in Insert mode
autocmd InsertLeave * set nocursorline
autocmd InsertEnter * set cursorline

"Search
set hlsearch   "(hls) highlight matches
set incsearch  "(is) jump to the first match while typing
set ignorecase "(ic) case-insensitive search
set smartcase  "(scs) case-sensitive when the pattern has uppercase letters
set showmatch  "(sm) show matching brackets ()[]{}

"Editing
"set spell spelllang=en_us "English spell check
set nobackup        "(nobk) no backup files (filename~)
set noswapfile      "(noswf) no swap files (.filename.swp)
"set undofile       "(udf) keep undo history
"set autochdir       "(acd) change to the file's directory
set history=1000    "(hi) command history size
set autoread        "(ar) reload files changed outside Vim
set listchars=tab:▸\ ,trail:·,extends:>,precedes:< " (lcs) show symbols for tabs and trailing spaces
set list
set wildmenu        "(wmnu) Tab completion menu for commands
set wildmode=longest:list,full  "(wim)
set noerrorbells    "(noeb) no error bell
set visualbell      "(vb) visual bell
set pastetoggle=<F12> "(pt) F12 switch paste mode

if has('clipboard')
  set clipboard+=unnamedplus    "Use the system clipboard
endif

"Automatically remove trailing spaces when saving a file.
"Skip markdown (two trailing spaces = line break) and diff/patch (trailing spaces are content).
augroup TrimWhitespace
  autocmd!
  autocmd BufWritePre * if &filetype !~# '^\(markdown\|diff\)$' | silent! keeppatterns %s/\s\+$//e | endif
augroup END

"Avoiding redrawtime exceeded syntax highlighting disabled issue
set re=0
