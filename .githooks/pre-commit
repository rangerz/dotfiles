#!/usr/bin/env bash
# Auto-format staged shell scripts with shfmt, then lint them with shellcheck
set -euo pipefail

for tool in shfmt shellcheck; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "[pre-commit] $tool is not installed (brew install $tool), or skip with --no-verify."
        exit 1
    fi
done

staged=()
while IFS= read -r -d '' f; do
    staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# Plain assignment so a shfmt error stops the hook (set -e misses failures inside <(...))
list=$(shfmt -f "${staged[@]}")
scripts=()
if [[ -n "$list" ]]; then
    while IFS= read -r f; do
        scripts+=("$f")
    done <<<"$list"
fi

# Format before copying the index below, so tests and shellcheck see what will be committed
# ${scripts[@]+...}: bash 3.2 treats an empty "${scripts[@]}" as unbound under set -u
for f in ${scripts[@]+"${scripts[@]}"}; do
    # Re-adding a partially staged file would sneak unstaged hunks into the commit, so only fix fully staged ones
    if git diff --quiet -- "$f"; then
        shfmt -w "$f"
        git add -- "$f"
    fi
done

# Run the tests on the staged copy, i.e. what will actually be committed, not the working tree
index="$(mktemp -d)"
trap 'rm -rf "$index"' EXIT
git checkout-index -a --prefix="$index/"

# Run every installer self-check, same set as scripts/check.sh; scripts/ covers top-level files too
for test in "$index"/*/test-install.sh "$index"/agents/*/test-install.sh; do
    [[ -f "$test" ]] || continue
    "$test"
done

((${#scripts[@]} > 0)) || exit 0

# Check the staged copy, i.e. what will actually be committed, not the working tree
fail=0
for f in "${scripts[@]}"; do
    # Lint the staged copy with -x so it follows `source` (e.g. agents/link.sh)
    if ! out=$(git show ":$f" | shfmt -d --filename "$f" 2>&1 && cd "$index" && shellcheck -x "$f" 2>&1); then
        echo "[pre-commit] $f"
        echo "$out"
        fail=1
    fi
done
exit "$fail"
